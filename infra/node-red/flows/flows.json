    {
        "id": "d28d72a442d64c6e",
        "type": "function",
        "z": "e7728c2fb6272181",
        "name": "Carregar limites",
        "func": "// padrão (aula 15)\nconst padrao = {\n    tempBaixa: 20,\n    tempAlta: 25,\n    umidadeAlta: 50,\n    histTemp: 0.5,\n    histUmidade: 2,\n    tempoPresenca: 10\n};\n\nlet limites = global.get('limites', 'file');\nif (!limites || msg.topic === 'reset') {\n    limites = padrao;\n    global.set('limites', limites, 'file');\n}\n\n// atualiza os sliders\nreturn [\n    { payload: limites.tempBaixa },\n    { payload: limites.tempAlta },\n    { payload: limites.umidadeAlta },\n    { payload: limites.histTemp },\n    { payload: limites.histUmidade },\n    { payload: limites.tempoPresenca }\n];\n",
