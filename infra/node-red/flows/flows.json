    {
        "id": "0559c4880d457e2d",
        "type": "function",
        "z": "e7728c2fb6272181",
        "name": "Verifica presença",
        "func": "const limites = global.get('limites', 'file');\nconst v = msg.payload.v;\n\nif (v === 1) {\n    // movimento: cancela o timer\n    clearTimeout(context.get('timer'));\n    context.set('timer', null);\n\n    if (context.get('ledLigado')) {\n        return [{ payload: 'Movimento detectado' }, null];\n    }\n    context.set('ledLigado', true);\n    return [{ payload: 'Movimento detectado' }, { payload: 'on' }];\n}\n\n// já está contando\nif (context.get('timer')) {\n    return null;\n}\n\n// sem movimento: apaga depois do tempo\nif (context.get('ledLigado')) {\n    const timer = setTimeout(function () {\n        context.set('timer', null);\n        context.set('ledLigado', false);\n        node.send([{ payload: 'Sem movimento' }, { payload: 'off' }]);\n    }, limites.tempoPresenca * 1000);\n    context.set('timer', timer);\n    return [{ payload: 'Sem movimento, LED apaga em ' + limites.tempoPresenca + ' s' }, null];\n}\n\nreturn [{ payload: 'Sem movimento' }, null];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 520,
        "wires": [
