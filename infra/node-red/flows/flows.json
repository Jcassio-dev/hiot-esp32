    {
        "id": "210560e77aa92a0e",
        "type": "function",
        "z": "e7728c2fb6272181",
        "name": "Verifica temperatura e umidade",
        "func": "const limites = global.get('limites', 'file');\nconst t = msg.payload.t;\nconst h = msg.payload.h;\n\n// estado anterior dos alertas\nlet tempAlta = flow.get('tempAlta') || false;\nlet tempBaixa = flow.get('tempBaixa') || false;\nlet umidadeAlta = flow.get('umidadeAlta') || false;\n\n// histerese\nif (t > limites.tempAlta) tempAlta = true;\nif (t <= limites.tempAlta - limites.histTemp) tempAlta = false;\n\nif (t < limites.tempBaixa) tempBaixa = true;\nif (t >= limites.tempBaixa + limites.histTemp) tempBaixa = false;\n\nif (h > limites.umidadeAlta) umidadeAlta = true;\nif (h <= limites.umidadeAlta - limites.histUmidade) umidadeAlta = false;\n\nflow.set('tempAlta', tempAlta);\nflow.set('tempBaixa', tempBaixa);\nflow.set('umidadeAlta', umidadeAlta);\n\nlet alertas = [];\nif (tempAlta) alertas.push('Temperatura alta');\nif (tempBaixa) alertas.push('Temperatura baixa');\nif (umidadeAlta) alertas.push('Umidade alta');\nconst textoAlertas = alertas.length > 0 ? alertas.join(', ') : 'Nenhum alerta';\n\n// só manda comando quando o LED muda\nconst ledTemp = tempAlta || tempBaixa;\nlet comandoTemp = null;\nif (ledTemp !== flow.get('ledTemp')) {\n    flow.set('ledTemp', ledTemp);\n    comandoTemp = { payload: ledTemp ? 'on' : 'off' };\n}\n\nlet comandoUmidade = null;\nif (umidadeAlta !== flow.get('ledUmidade')) {\n    flow.set('ledUmidade', umidadeAlta);\n    comandoUmidade = { payload: umidadeAlta ? 'on' : 'off' };\n}\n\nreturn [\n    { topic: 'Temperatura', payload: t },\n    { topic: 'Umidade', payload: h },\n    comandoTemp,\n    comandoUmidade,\n    { payload: textoAlertas }\n];\n",
        "outputs": 5,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 100,
        "wires": [
