# Copie para .env (cp .env.example .env) e troque todos os valores.
# O .env não vai para o git.

# Senha do usuário MQTT "esp32", usada pelo firmware (MQTT_PASS no secrets.h).
MQTT_ESP32_PASS=troque-esta-senha-esp32

# Senha do usuário MQTT "nodered", usada pelo Node-RED.
MQTT_NODERED_PASS=troque-esta-senha-nodered

# Usuário do editor do Node-RED (http://<ip-da-vm>:1880).
NODE_RED_ADMIN_USER=admin

# Hash bcrypt da senha do editor. Gere com: scripts/hash-node-red-password.sh
# Mantenha as aspas simples: sem elas o docker compose tenta interpretar os "$" do hash.
NODE_RED_ADMIN_HASH='$2b$08$substitua.pelo.hash.gerado.pelo.script.................'

# Chave que criptografa as credenciais salvas pelo Node-RED. Qualquer texto longo e aleatório,
# por exemplo a saída de: openssl rand -hex 32
NODE_RED_CREDENTIAL_SECRET=troque-por-um-texto-aleatorio

# Fuso horário dos containers (só afeta logs; os timestamps das mensagens são epoch UTC).
TZ=America/Fortaleza

# Portas publicadas na VM. Libere no firewall só para os IPs que você usa.
MQTT_PUBLIC_PORT=1883
NODE_RED_PUBLIC_PORT=1880
